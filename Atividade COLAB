      "source": [
        "# Instalação da biblioteca apyori\n",
        "!pip install apyori\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from apyori import apriori\n",
        "\n",
        "# Carregando a base de dados\n",
        "base_mercado2 = pd.read_csv('/content/mercado2.csv', header=None)\n",
        "\n",
        "# Formatando as transações em uma lista de listas\n",
        "transacoes = []\n",
        "for i in range(len(base_mercado2)):\n",
        "  transacoes.append([str(base_mercado2.values[i, j]) for j in range(base_mercado2.shape[1])])\n",
        "\n",
        "# Execução do Apriori\n",
        "regras = apriori(\n",
        "    transacoes,\n",
        "    min_support=0.003,\n",
        "    min_confidence=0.2,\n",
        "    min_lift=3.0,\n",
        "    min_length=2,\n",
        ")\n",
        "\n",
        "resultados = list(regras)\n",
        "dados_regras = []\n",
        "\n",
        "for resultado in resultados:\n",
        "  suporte_conjunto = resultado.support\n",
        "  for ordered_stat in resultado.ordered_statistics:\n",
        "    antecedente = set(ordered_stat.items_base)\n",
        "    consequente = set(ordered_stat.items_add)\n",
        "\n",
        "    # Filtrar valores nulos\n",
        "    if 'nan' in antecedente or 'nan' in consequente or len(antecedente) == 0 or len(consequente) == 0:\n",
        "      continue\n",
        "\n",
        "    confianca = ordered_stat.confidence\n",
        "    lift = ordered_stat.lift\n",
        "\n",
        "    # Suporte do consequente (P(Y))\n",
        "    suporte_y = confianca / lift if lift != 0 else 0\n",
        "\n",
        "    # Cálculo da Convicção\n",
        "    if confianca == 1.0:\n",
        "      conviccao = np.inf\n",
        "    else:\n",
        "      conviccao = (1 - suporte_y) / (1 - confianca)\n",
        "\n",
        "    dados_regras.append({\n",
        "        'Antecedente (SE)': ', '.join(antecedente),\n",
        "        'Consequente (ENTÃO)': ', '.join(consequente),\n",
        "        'Suporte': suporte_conjunto,\n",
        "        'Suporte_Y': suporte_y,\n",
        "        'Confiança': confianca,\n",
        "        'Lift': lift,\n",
        "        'Convicção': conviccao,\n",
        "    })\n",
        "\n",
        "df_regras = pd.DataFrame(dados_regras)\n",
        "\n",
        "# Exibir os resultados\n",
        "if not df_regras.empty:\n",
        "    display(df_regras.sort_values(by='Lift', ascending=False))\n",
        "else:\n",
        "    print('Nenhuma regra encontrada com os parâmetros atuais.')"
      ]
